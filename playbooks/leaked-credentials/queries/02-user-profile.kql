// Step 2: who the user is and how much damage the account could do
// Privileged roles, a hybrid (synced) account or a finance / exec job title raise the priority.
// RiskLevel / RiskLevelDetails reflect Entra ID Protection user risk ("high" + "leakedCredentials" is typical)
let user = "user@domain.com";
IdentityInfo
| where Timestamp > ago(14d)
| where AccountUpn =~ user
| summarize arg_max(Timestamp, *) by AccountObjectId
| project Timestamp, AccountUpn, AccountDisplayName, AccountObjectId, OnPremSid, AccountName, AccountDomain,
          JobTitle, Department, Manager, IsAccountEnabled, CreatedDateTime, SourceProvider,
          AssignedRoles, RiskLevel, RiskLevelDetails, Tags
