// Step 5: has someone tried the leaked password?
// The error code tells you whether the password was RIGHT even when the sign-in failed:
//   50126            wrong password                 -> attacker has an old / wrong password (good news)
//   50074, 50076     MFA required                   -> password was CORRECT, MFA stopped it
//   500121           MFA failed / denied            -> password CORRECT, MFA prompt denied (possible MFA fatigue)
//   53003            blocked by Conditional Access  -> password CORRECT, CA stopped it
//   50055, 50144     password expired               -> password CORRECT
//   50053            account locked / malicious IP  -> repeated attempts
//   0                success                        -> check it came from the user (step 6)
let user = "user@domain.com";
let knownIPs = dynamic([]);   // optional: the user's normal IPs from step 4, to hide them
EntraIdSignInEvents
| where Timestamp > ago(30d) and AccountUpn =~ user
| where IPAddress !in (knownIPs)
| extend Meaning = case(
    ErrorCode == 0, "Success",
    ErrorCode == 50126, "Wrong password",
    ErrorCode in (50074, 50076), "Password correct - MFA required",
    ErrorCode == 500121, "Password correct - MFA failed/denied",
    ErrorCode == 53003, "Password correct - blocked by CA",
    ErrorCode in (50055, 50144), "Password correct - expired",
    ErrorCode == 50053, "Locked / malicious IP",
    strcat("Other (", tostring(ErrorCode), ")"))
| summarize Attempts = count(), FirstSeen = min(Timestamp), LastSeen = max(Timestamp),
            Apps = make_set(Application, 10), ClientApps = make_set(ClientAppUsed, 5), UserAgents = make_set(UserAgent, 5)
            by IPAddress, Country, City, Meaning
| sort by FirstSeen asc
