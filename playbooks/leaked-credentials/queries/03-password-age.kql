// Step 3: is the leaked password still the current password?
// Microsoft only raises "Leaked credentials" when the leaked pair matches the user's CURRENT password hash
// (password hash sync for hybrid users). So the key question is: has the password changed since?
// Part A: last password change as seen on each sign-in (LastPasswordChangeTimestamp)
let user = "user@domain.com";
EntraIdSignInEvents
| where Timestamp > ago(30d) and AccountUpn =~ user
| where isnotempty(LastPasswordChangeTimestamp)
| summarize LastPasswordChange = max(LastPasswordChangeTimestamp), LastSignIn = max(Timestamp)
| extend PasswordAgeDays = datetime_diff("day", now(), LastPasswordChange)
