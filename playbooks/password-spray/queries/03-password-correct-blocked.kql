// Step 3: users whose password was CORRECT but MFA or Conditional Access stopped the sign-in, from spraying IPs
// 50074/50076 = MFA required, 500121 = MFA failed/denied, 53003 = blocked by CA
// These passwords are known to the attacker: reset them
let lookback = 1d;
let minUsers = 10;
let sprayIPs = EntraIdSignInEvents
    | where Timestamp > ago(lookback) and ErrorCode in (50126, 50053, 50034)
    | summarize TargetedUsers = dcount(AccountUpn) by IPAddress
    | where TargetedUsers >= minUsers
    | project IPAddress;
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where IPAddress in (sprayIPs)
| where ErrorCode in (50074, 50076, 500121, 53003)
| summarize Attempts = count(), ErrorCodes = make_set(ErrorCode), IPs = make_set(IPAddress, 10),
            Apps = make_set(Application, 10), First = min(Timestamp), Last = max(Timestamp)
            by AccountUpn
| sort by First asc
