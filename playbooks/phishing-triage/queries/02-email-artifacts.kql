// Step 2: URLs and attachments in the email, to pivot on in steps 3-5
// RiskFlags highlights attachment types and URL patterns commonly used in phishing; an empty flag is not proof of safety
// Look up every SHA256 and URL domain in VirusTotal or your threat intel before calling it clean
let networkMessageId = "<NetworkMessageId>";
let riskyExtensions = dynamic(["exe", "scr", "js", "jse", "vbs", "vbe", "wsf", "hta", "lnk", "iso", "img", "vhd",
                               "html", "htm", "shtml", "svg", "zip", "rar", "7z", "docm", "xlsm", "pptm", "one", "msi", "bat", "cmd", "ps1"]);
let shorteners = dynamic(["bit.ly", "tinyurl.com", "t.co", "is.gd", "rb.gy", "cutt.ly", "ow.ly", "shorturl.at"]);
union
( EmailUrlInfo
  | where NetworkMessageId == networkMessageId
  | extend RiskFlags = strcat_array(set_difference(pack_array(
        iff(UrlDomain in~ (shorteners), "URL shortener", ""),
        iff(UrlDomain matches regex @"^\d{1,3}(\.\d{1,3}){3}$", "IP address instead of domain", ""),
        iff(Url has "@", "@ in URL", "")), dynamic([""])), "; ")
  | project Type = "URL", Value = Url, Detail = strcat(UrlDomain, " | found in: ", UrlLocation), SHA256 = "", RiskFlags ),
( EmailAttachmentInfo
  | where NetworkMessageId == networkMessageId
  | extend Ext = tolower(extract(@"\.([^.]+)$", 1, FileName))
  | extend RiskFlags = strcat_array(set_difference(pack_array(
        iff(FileName matches regex @"\.[A-Za-z0-9]{2,4}\.[A-Za-z0-9]{2,4}$", "double extension", ""),
        iff(Ext in (riskyExtensions), strcat("risky type: ", Ext), ""),
        iff(isnotempty(ThreatTypes), strcat("Defender verdict: ", ThreatTypes), "")), dynamic([""])), "; ")
  | project Type = "Attachment", Value = FileName, Detail = strcat(FileType, " | threats: ", tostring(ThreatTypes)), SHA256, RiskFlags )
| distinct Type, Value, Detail, SHA256, RiskFlags
| sort by RiskFlags desc
