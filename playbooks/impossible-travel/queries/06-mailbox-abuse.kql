// Step 6: mailbox abuse (inbox rules, forwarding, delegation, mail access, deletions)
// Classic signs: rules that forward externally, delete, mark as read, or move mail to RSS Feeds or Archive,
// especially rules that filter on words like invoice, payment or bank
let user = "user@domain.com";
let badIP = "x.x.x.x";
let userId = toscalar(EntraIdSignInEvents | where AccountUpn =~ user | take 1 | project AccountObjectId);
CloudAppEvents
| where Timestamp > ago(14d)
| where AccountObjectId == userId or IPAddress == badIP
| where ActionType in ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules", "Set-Mailbox",
                       "Add-MailboxPermission", "Add-RecipientPermission", "MailItemsAccessed",
                       "Send", "SendAs", "SendOnBehalf", "HardDelete", "SoftDelete", "MoveToDeletedItems")
| summarize Count = count(), First = min(Timestamp), Last = max(Timestamp),
            Sample = take_any(RawEventData) by ActionType, IPAddress, CountryCode, ISP
| sort by First asc
