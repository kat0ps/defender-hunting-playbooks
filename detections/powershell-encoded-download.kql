// Detection: Encoded PowerShell whose decoded content downloads or executes code
// Playbook: playbooks/suspicious-powershell/README.md
// Severity: High | Frequency: Every 1 hour | MITRE: T1059.001, T1027.010, T1105
// Entities: Device = DeviceId, User = AccountObjectId
// Tuning: exclude management agents (Intune/SCCM/RMM) by InitiatingProcessFileName after review
// Status: Untested
DeviceProcessEvents
| where Timestamp > ago(4h)
| where FileName in~ ("powershell.exe", "pwsh.exe", "powershell_ise.exe")
| where ProcessCommandLine matches regex @'(?i)\s[-/]e[a-z]*\s+[A-Za-z0-9+/=]{20,}'
| extend Encoded = extract(@'(?i)\s[-/]e[a-z]*\s+([A-Za-z0-9+/=]{20,})', 1, ProcessCommandLine)
| extend Decoded = replace_regex(base64_decode_tostring(Encoded), @'\x00', '')
| where Decoded has_any ("IEX", "Invoke-Expression", "DownloadString", "DownloadFile", "Net.WebClient",
                         "Invoke-WebRequest", "FromBase64String", "Start-BitsTransfer")
| project Timestamp, ReportId, DeviceId, DeviceName, AccountObjectId, AccountName,
          InitiatingProcessFileName, Decoded, ProcessCommandLine
