// Impossible travel: successful Entra ID sign-ins whose implied travel speed is above maxSpeedKmh
// Platform: Microsoft Defender XDR Advanced Hunting
// Table: EntraIdSignInEvents (or AADSignInEventsBeta, which has the same columns)
// Tune: add your VPN/proxy egress ranges to excludedRanges
let lookback = 7d;
let maxSpeedKmh = 900;      // roughly commercial jet speed
let minDistanceKm = 500;    // ignore small jumps caused by IP geolocation noise
let excludedRanges = dynamic([]);   // e.g. dynamic(["203.0.113.0/24"])
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode == 0
| where array_length(excludedRanges) == 0 or not(ipv4_is_in_any_range(IPAddress, excludedRanges))
| extend Lat = todouble(Latitude), Lon = todouble(Longitude)
| where isnotnull(Lat) and isnotnull(Lon)
| project Timestamp, AccountUpn, AccountObjectId, IPAddress, City, Country, Lat, Lon,
          Application, ClientAppUsed, LogonType, UserAgent, OSPlatform, Browser,
          AadDeviceId, IsManaged, IsCompliant, SessionId
| sort by AccountObjectId asc, Timestamp asc
| extend PrevAcct = prev(AccountObjectId), PrevTime = prev(Timestamp), PrevIP = prev(IPAddress),
         PrevCity = prev(City), PrevCountry = prev(Country), PrevLat = prev(Lat), PrevLon = prev(Lon),
         PrevApp = prev(Application), PrevDevice = prev(AadDeviceId), PrevSession = prev(SessionId)
| where AccountObjectId == PrevAcct and IPAddress != PrevIP
| extend DistanceKm = round(geo_distance_2points(PrevLon, PrevLat, Lon, Lat) / 1000.0, 0),
         HoursBetween = round((Timestamp - PrevTime) / 1h, 2)
| where DistanceKm >= minDistanceKm
| extend SpeedKmh = round(DistanceKm / max_of(HoursBetween, 0.01), 0)
| where SpeedKmh > maxSpeedKmh
| extend SameDevice = isnotempty(AadDeviceId) and AadDeviceId == PrevDevice,
         SameSession = isnotempty(SessionId) and SessionId == PrevSession
| project AccountUpn,
          FromTime = PrevTime, FromIP = PrevIP, FromLocation = strcat(PrevCity, ", ", PrevCountry), FromApp = PrevApp,
          ToTime = Timestamp, ToIP = IPAddress, ToLocation = strcat(City, ", ", Country), ToApp = Application,
          DistanceKm, HoursBetween, SpeedKmh, SameDevice, SameSession,
          LogonType, ClientAppUsed, OSPlatform, Browser, IsManaged, IsCompliant, UserAgent
| sort by SpeedKmh desc
