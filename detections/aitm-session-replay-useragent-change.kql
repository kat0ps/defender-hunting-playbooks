// Detection: One sign-in session used from more than one country AND more than one user agent (session cookie replay)
// Playbook: playbooks/aitm-token-theft/README.md
// Severity: High | Frequency: Every 24 hours | MITRE: T1539, T1550.004
// Entities: User = AccountObjectId, IP = IPAddress (most recent)
// Tuning: travelling users on VPNs can trigger the country part; the user-agent change is what makes it high-fidelity
// Status: Untested
EntraIdSignInEvents
| where Timestamp > ago(1d) and ErrorCode == 0 and isnotempty(SessionId)
| summarize arg_max(Timestamp, ReportId, IPAddress), CountryCount = dcount(Country), Countries = make_set(Country, 10),
            UADistinct = dcount(UserAgent), UserAgents = make_set(UserAgent, 5), IPs = make_set(IPAddress, 20)
            by AccountObjectId, AccountUpn, SessionId
| where CountryCount > 1 and UADistinct > 1
| project Timestamp, ReportId, AccountObjectId, AccountUpn, SessionId, IPAddress, Countries, UserAgents, IPs
