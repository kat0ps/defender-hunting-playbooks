// Detection: A spraying IP (failures against 10+ users) got a correct password: signed in, or was only stopped by MFA/CA
// Playbook: playbooks/password-spray/README.md
// Severity: High | Frequency: Every 3 hours | MITRE: T1110.003, T1078.004
// Entities: User = AccountObjectId, IP = IPAddress
// Tuning: raise minUsers in large tenants; exclude your own office egress IPs (shared NAT)
// Status: Untested
let lookback = 12h;
let minUsers = 10;
let sprayIPs = EntraIdSignInEvents
    | where Timestamp > ago(lookback) and ErrorCode in (50126, 50053, 50034)
    | summarize TargetedUsers = dcount(AccountUpn) by IPAddress
    | where TargetedUsers >= minUsers;
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode in (0, 50074, 50076, 500121, 53003)
| join kind=inner sprayIPs on IPAddress
| extend Outcome = iff(ErrorCode == 0, "Signed in", "Password correct - stopped by MFA/CA")
| summarize arg_max(Timestamp, ReportId, ErrorCode, Application), Outcomes = make_set(Outcome)
            by AccountObjectId, AccountUpn, IPAddress, TargetedUsers
| project Timestamp, ReportId, AccountObjectId, AccountUpn, IPAddress, TargetedUsers, Outcomes, ErrorCode, Application
